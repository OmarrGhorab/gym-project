# Shared secret. Must match WHATSAPP_SERVICE_TOKEN in the Laravel backend's .env.
# Generate one with: openssl rand -hex 32
WHATSAPP_SERVICE_TOKEN=

# Laravel talks to this over loopback on the same VPS. Do not expose it publicly:
# anyone who can reach this port can send WhatsApp messages as the gym.
HOST=127.0.0.1
PORT=3001

# Where the linked-device credentials are stored, relative to the service
# directory (not the working directory — cron runs from $HOME). Back this up:
# losing it means re-scanning the QR from the gym's phone.
AUTH_DIR=auth_info

# Gap between consecutive sends, in milliseconds. Randomised within the range.
# Lowering these raises the risk of the number being banned.
MIN_GAP_MS=5000
MAX_GAP_MS=20000

MAX_QUEUE_DEPTH=100
SEND_TIMEOUT_MS=60000

LOG_LEVEL=warn
